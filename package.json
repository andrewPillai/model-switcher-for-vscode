{
  "name": "nvidia-chat-model-switcher",
  "displayName": "Model Switcher for VS Code",
  "description": "Connect OpenAI-compatible chat model APIs to the VS Code Chat model picker.",
  "version": "0.4.0",
  "publisher": "local-development",
  "engines": {
    "vscode": "^1.100.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andrewPillai/model-switcher-for-vscode.git"
  },
  "categories": [
    "Machine Learning"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:nvidia-chat-model-switcher.openConfig",
    "onCommand:nvidia-chat-model-switcher.applyConfig",
    "onCommand:nvidia-chat-model-switcher.testModel"
  ],
  "contributes": {
    "commands": [
      {
        "command": "nvidia-chat-model-switcher.openConfig",
        "title": "Model Switcher: Open Model Configuration"
      },
      {
        "command": "nvidia-chat-model-switcher.applyConfig",
        "title": "Model Switcher: Apply Model Configuration"
      },
      {
        "command": "nvidia-chat-model-switcher.testModel",
        "title": "Model Switcher: Test Model Connection"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "nvidia-chat-model-switcher",
        "displayName": "Model Switcher for VS Code"
      }
    ]
  },
  "scripts": {
    "test": "node --test",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  }
}
